data_mdcif_ext.dic

_datablock.id                 mdcif_ext.dic
_datablock.description
;
     DRAFT extension dictionary for mdcif: MD simulation provenance,
     global and per-model essential (PCA / quasi-harmonic) modes, and the
     projection of the trajectory frames onto the global modes. Intended to
     be used together with mmcif_pdbx.dic and mmcif_ihm.dic.
;

_dictionary.title             mdcif_ext.dic
_dictionary.datablock_id      mdcif_ext.dic
_dictionary.version           0.0.4

loop_
_dictionary_history.version
_dictionary_history.update
_dictionary_history.revision
0.0.1 2026-10-05 'Initial draft: mdcif_simulation, mdcif_mode, mdcif_mode_vector.'
0.0.2 2026-10-06
;   Mode sets (global + per cluster): new mdcif_mode_set, mdcif_mode_origin,
    mdcif_projection; mdcif_mode now points at a mode set.
;
0.0.3 2026-10-13
;   New mdcif_mode.cartesian_variance: display amplitude in square angstroms,
    also for mass-weighted (quasi-harmonic) modes.
;
0.0.4 2026-10-13
;   Removed items that follow from others: mdcif_mode_set.scope (ensemble_id),
    mass_weighted (method), details; mdcif_mode.mode_index (eigenvalue rank),
    variance_fraction and cumulative_variance_fraction (eigenvalue /
    total_variance), cartesian_variance (eigenvalue and element masses);
    mdcif_projection.id and mode_set_id (always the global set; the key is
    now frame).
;

##############################################################################
#                           MDCIF_SIMULATION                                 #
##############################################################################

save_mdcif_simulation
    _category.description
;   Conditions of an MD simulation that are not covered by the IHM
    modeling protocol categories.
;
    _category.id                  mdcif_simulation
    _category.mandatory_code      no
    _category_key.name            '_mdcif_simulation.id'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_simulation.id
    _item_description.description  'Unique identifier for this simulation.'
    _item.name                     '_mdcif_simulation.id'
    _item.category_id              mdcif_simulation
    _item.mandatory_code           yes
    _item_type.code                int
    save_

