##############################################################################
#                             MDCIF_MODE_SET                                 #
##############################################################################

save_mdcif_mode_set
    _category.description
;   A set of essential modes (PCA or quasi-harmonic eigenvectors) from one
    covariance analysis. Without ensemble_id it is the global set: all
    analysed frames, superposed on their average; its leading modes are the
    axes the frames were clustered on. With ensemble_id it is a cluster set:
    the frames of that cluster, superposed on its deposited model.
;
    _category.id                  mdcif_mode_set
    _category.mandatory_code      no
    _category_key.name            '_mdcif_mode_set.id'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_mode_set.id
    _item_description.description  'Unique identifier for the mode set.'
    _item.name                     '_mdcif_mode_set.id'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           yes
    _item_type.code                int
    save_

save__mdcif_mode_set.model_id
    _item_description.description
;   The deposited model whose atoms the vector components (and origin)
    refer to. For a cluster set, the cluster's representative model; for
    the global set, the first model (all models share the same atoms and
    coordinate frame).
;
    _item.name                     '_mdcif_mode_set.model_id'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           yes
    _item_type.code                int
    _item_linked.child_name        '_mdcif_mode_set.model_id'
    _item_linked.parent_name       '_ihm_model_list.model_id'
    save_

save__mdcif_mode_set.ensemble_id
    _item_description.description  'The cluster (ensemble) whose frames were analysed; "." for the global set.'
    _item.name                     '_mdcif_mode_set.ensemble_id'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           no
    _item_type.code                int
    _item_linked.child_name        '_mdcif_mode_set.ensemble_id'
    _item_linked.parent_name       '_ihm_ensemble_info.ensemble_id'
    save_

save__mdcif_mode_set.method
    _item_description.description  'Method used to obtain the modes.'
    _item.name                     '_mdcif_mode_set.method'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           yes
    _item_type.code                line
    loop_
    _item_enumeration.value
    _item_enumeration.detail
        PCA             'covariance of the Cartesian coordinates, not mass-weighted'
        quasi-harmonic  'mass-weighted covariance, standard element masses'
        ANM             'anisotropic network model'
        other           .
    save_

save__mdcif_mode_set.atom_selection
    _item_description.description  'Atoms included in the analysis, e.g. "name CA".'
    _item.name                     '_mdcif_mode_set.atom_selection'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           no
    _item_type.code                line
    save_

save__mdcif_mode_set.num_frames
    _item_description.description  'Number of trajectory frames used to build the covariance matrix.'
    _item.name                     '_mdcif_mode_set.num_frames'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           no
    _item_type.code                int
    save_

save__mdcif_mode_set.total_variance
    _item_description.description
;   Trace of the covariance matrix (sum of all eigenvalues), in square
    angstroms (amu * square angstroms if method is quasi-harmonic).
;
    _item.name                     '_mdcif_mode_set.total_variance'
    _item.category_id              mdcif_mode_set
    _item.mandatory_code           no
    _item_type.code                float
    save_

##############################################################################
#                               MDCIF_MODE                                   #
##############################################################################

save_mdcif_mode
    _category.description
;   One essential mode of a mode set and its eigenvalue. Within a set, mode 1
    is the one with the largest eigenvalue, mode 2 the next, and so on; the
    fraction of the variance a mode explains is eigenvalue / total_variance
    of its set. Components are in mdcif_mode_vector.
;
    _category.id                  mdcif_mode
    _category.mandatory_code      no
    _category_key.name            '_mdcif_mode.id'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_mode.id
    _item_description.description  'Unique identifier for the mode.'
    _item.name                     '_mdcif_mode.id'
    _item.category_id              mdcif_mode
    _item.mandatory_code           yes
    _item_type.code                int
    save_

save__mdcif_mode.mode_set_id
    _item_description.description  'The mode set this mode belongs to.'
    _item.name                     '_mdcif_mode.mode_set_id'
    _item.category_id              mdcif_mode
    _item.mandatory_code           yes
    _item_type.code                int
    _item_linked.child_name        '_mdcif_mode.mode_set_id'
    _item_linked.parent_name       '_mdcif_mode_set.id'
    save_

save__mdcif_mode.eigenvalue
    _item_description.description
;   Eigenvalue of the mode: variance along the mode in square angstroms
    (PCA), or in amu * square angstroms for quasi-harmonic (mass-weighted)
    sets. For those, the variance of the Cartesian motion along the unit
    vector v is eigenvalue / sum_j m_j |v_j|^2, with m_j the standard atomic
    mass (amu) of the element of atom j.
;
    _item.name                     '_mdcif_mode.eigenvalue'
    _item.category_id              mdcif_mode
    _item.mandatory_code           yes
    _item_type.code                float
    save_

##############################################################################
#                            MDCIF_MODE_VECTOR                               #
##############################################################################

save_mdcif_mode_vector
    _category.description
;   Per-atom components of a mode eigenvector, as a Cartesian displacement
    in the frame of the deposited model. The full 3N vector has unit length.
;
    _category.id                  mdcif_mode_vector
    _category.mandatory_code      no
    loop_
    _category_key.name            '_mdcif_mode_vector.mode_id'
                                  '_mdcif_mode_vector.atom_id'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_mode_vector.mode_id
    _item_description.description  'The mode this component belongs to.'
    _item.name                     '_mdcif_mode_vector.mode_id'
    _item.category_id              mdcif_mode_vector
    _item.mandatory_code           yes
    _item_type.code                int
    _item_linked.child_name        '_mdcif_mode_vector.mode_id'
    _item_linked.parent_name       '_mdcif_mode.id'
    save_

save__mdcif_mode_vector.atom_id
    _item_description.description  'The atom (in the mode model) this component applies to.'
    _item.name                     '_mdcif_mode_vector.atom_id'
    _item.category_id              mdcif_mode_vector
    _item.mandatory_code           yes
    _item_type.code                code
    _item_linked.child_name        '_mdcif_mode_vector.atom_id'
    _item_linked.parent_name       '_atom_site.id'
    save_

save__mdcif_mode_vector.dx
    _item_description.description  'X component of the eigenvector for this atom.'
    _item.name                     '_mdcif_mode_vector.dx'
    _item.category_id              mdcif_mode_vector
    _item.mandatory_code           yes
    _item_type.code                float
    save_

save__mdcif_mode_vector.dy
    _item_description.description  'Y component of the eigenvector for this atom.'
    _item.name                     '_mdcif_mode_vector.dy'
    _item.category_id              mdcif_mode_vector
    _item.mandatory_code           yes
    _item_type.code                float
    save_

save__mdcif_mode_vector.dz
    _item_description.description  'Z component of the eigenvector for this atom.'
    _item.name                     '_mdcif_mode_vector.dz'
    _item.category_id              mdcif_mode_vector
    _item.mandatory_code           yes
    _item_type.code                float
    save_

##############################################################################
#                            MDCIF_MODE_ORIGIN                               #
##############################################################################

save_mdcif_mode_origin
    _category.description
;   The mean structure a mode set was computed about, on the atoms of its
    vectors. Written for the global set so that any structure, superposed on
    this origin, can be projected onto the modes: p_i = (x - origin) . v_i.
;
    _category.id                  mdcif_mode_origin
    _category.mandatory_code      no
    loop_
    _category_key.name            '_mdcif_mode_origin.mode_set_id'
                                  '_mdcif_mode_origin.atom_id'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_mode_origin.mode_set_id
    _item_description.description  'The mode set this origin belongs to.'
    _item.name                     '_mdcif_mode_origin.mode_set_id'
    _item.category_id              mdcif_mode_origin
    _item.mandatory_code           yes
    _item_type.code                int
    _item_linked.child_name        '_mdcif_mode_origin.mode_set_id'
    _item_linked.parent_name       '_mdcif_mode_set.id'
    save_

save__mdcif_mode_origin.atom_id
    _item_description.description  'The atom (in the mode set model) this mean position belongs to.'
    _item.name                     '_mdcif_mode_origin.atom_id'
    _item.category_id              mdcif_mode_origin
    _item.mandatory_code           yes
    _item_type.code                code
    _item_linked.child_name        '_mdcif_mode_origin.atom_id'
    _item_linked.parent_name       '_atom_site.id'
    save_

save__mdcif_mode_origin.x
    _item_description.description  'Mean X coordinate, in angstroms, in the frame of the deposited models.'
    _item.name                     '_mdcif_mode_origin.x'
    _item.category_id              mdcif_mode_origin
    _item.mandatory_code           yes
    _item_type.code                float
    save_

save__mdcif_mode_origin.y
    _item_description.description  'Mean Y coordinate, in angstroms, in the frame of the deposited models.'
    _item.name                     '_mdcif_mode_origin.y'
    _item.category_id              mdcif_mode_origin
    _item.mandatory_code           yes
    _item_type.code                float
    save_

save__mdcif_mode_origin.z
    _item_description.description  'Mean Z coordinate, in angstroms, in the frame of the deposited models.'
    _item.name                     '_mdcif_mode_origin.z'
    _item.category_id              mdcif_mode_origin
    _item.mandatory_code           yes
    _item_type.code                float
    save_

##############################################################################
#                            MDCIF_PROJECTION                                #
##############################################################################

save_mdcif_projection
    _category.description
;   Coordinates of analysed trajectory frames along modes 1-3 of the global
    mode set (the mode set without ensemble_id), with the deposited model
    whose cluster each frame belongs to.
    Enough to redraw the conformational landscape and the clusters from the
    file alone. May hold a regular subsample of the frames.
;
    _category.id                  mdcif_projection
    _category.mandatory_code      no
    _category_key.name            '_mdcif_projection.frame'
    loop_
    _category_group.id            'inclusive_group'
    save_

save__mdcif_projection.frame
    _item_description.description  '0-based index of the frame in the (concatenated) trajectory.'
    _item.name                     '_mdcif_projection.frame'
    _item.category_id              mdcif_projection
    _item.mandatory_code           yes
    _item_type.code                int
    save_

save__mdcif_projection.time
    _item_description.description  'Simulation time of the frame in picoseconds.'
    _item.name                     '_mdcif_projection.time'
    _item.category_id              mdcif_projection
    _item.mandatory_code           no
    _item_type.code                float
    save_

save__mdcif_projection.model_id
    _item_description.description
;   The deposited model representing the cluster this frame belongs to;
    "." if the frame is noise or its cluster was not deposited.
;
    _item.name                     '_mdcif_projection.model_id'
    _item.category_id              mdcif_projection
    _item.mandatory_code           no
    _item_type.code                int
    _item_linked.child_name        '_mdcif_projection.model_id'
    _item_linked.parent_name       '_ihm_model_list.model_id'
    save_

save__mdcif_projection.proj_1
    _item_description.description  'Coordinate along mode 1, (x - origin) . v_1, in angstroms.'
    _item.name                     '_mdcif_projection.proj_1'
    _item.category_id              mdcif_projection
    _item.mandatory_code           yes
    _item_type.code                float
    save_

save__mdcif_projection.proj_2
    _item_description.description  'Coordinate along mode 2, in angstroms.'
    _item.name                     '_mdcif_projection.proj_2'
    _item.category_id              mdcif_projection
    _item.mandatory_code           no
    _item_type.code                float
    save_

save__mdcif_projection.proj_3
    _item_description.description  'Coordinate along mode 3, in angstroms.'
    _item.name                     '_mdcif_projection.proj_3'
    _item.category_id              mdcif_projection
    _item.mandatory_code           no
    _item_type.code                float
    save_
