    _item.category_id              mdcif_simulation
    _item.mandatory_code           no
    _item_type.code                int
    _item_linked.child_name        '_mdcif_simulation.protocol_id'
    _item_linked.parent_name       '_ihm_modeling_protocol.id'
    save_

